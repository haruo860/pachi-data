---
import Base from '../layouts/Base.astro';
export function getStaticPaths(){const P:any={
about:['運営者情報','<p>サイト名：PACHI DATA</p><p>運営者名・所在地・連絡先：【運営者が記入してください】</p><p>当サイトはパチンコに関する情報提供を目的とした情報メディアです。</p>'],
contact:['お問い合わせ','<p>お問い合わせ先：【メールアドレスまたはフォームURLを記入してください】</p>'],
privacy:['プライバシーポリシー','<p>当サイトはアクセス解析（Google Analytics等）や広告配信サービス（Google AdSense等）を利用する場合があり、Cookieを使用して利用状況を収集します。個人を特定する情報は含まれません。Cookieはブラウザ設定で無効にできます。※利用するサービスに合わせて内容を更新してください。</p>'],
disclaimer:['免責事項','<p>当サイトは遊技に関する情報提供を目的とし、勝利や利益を保証するものではありません。掲載情報は正確性に努めていますが、機種情報・数値は変更される場合があるため、必ず公式情報をご確認ください。当サイトの利用による損害について責任を負いかねます。パチンコは20歳以上の方が、無理のない範囲でお楽しみください。</p>'],
advertise:['広告掲載について','<p>広告掲載のご相談は【連絡先を記入してください】までご連絡ください。広告は広告と分かる形で表示します。</p>']};
return Object.entries(P).map(([k,v]:any)=>({params:{page:k},props:{t:v[0],b:v[1]}}))}
const {t,b}=Astro.props;
---
<Base title={t}><div class="w" style="max-width:780px"><h1>{t}</h1><div set:html={b}/></div></Base>
