---
import { SITE } from '../config';
const { title, description=SITE.desc, noindex=false, image='/ogp.svg', canonical, ld=[], type='website' } = Astro.props;
const url = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const full = title ? `${title} | ${SITE.name}` : `${SITE.name} | ${SITE.tagline}`;
const img = new URL(image, Astro.site).href;
const site = Astro.site!.href.replace(/\/$/,'');
const base = [{'@context':'https://schema.org','@type':'WebSite',name:SITE.name,url:site+'/'},{'@context':'https://schema.org','@type':'Organization',name:SITE.name,url:site+'/',logo:site+'/logo.svg'}];
const all = (Astro.url.pathname==='/'?base:[]).concat(ld);
---
<!doctype html><html lang="ja"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{full}</title><meta name="description" content={description}><link rel="canonical" href={url}>
<meta name="google-site-verification" content="dUf9v3khAIcS9OZHNkrrHgq_aAvin3aqD3MqndXCsLs" />
{noindex && <meta name="robots" content="noindex,follow">}
<meta property="og:type" content={type}><meta property="og:title" content={full}><meta property="og:description" content={description}><meta property="og:url" content={url}><meta property="og:image" content={img}><meta property="og:site_name" content={SITE.name}><meta property="og:locale" content="ja_JP">
<meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content={full}><meta name="twitter:description" content={description}><meta name="twitter:image" content={img}>
<link rel="icon" href="/logo.svg" type="image/svg+xml">
{all.map(j=><script type="application/ld+json" set:html={JSON.stringify(j)} />)}
{SITE.ga4 && <><script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.ga4}`}></script><script is:inline define:vars={{id:SITE.ga4}}>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config',id);</script></>}
<style is:global>
:root{--bg:#0a1020;--card:#121a30;--gold:#c9a24b;--red:#d03a3a;--tx:#e8e8ee;--mu:#9aa3b8}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--tx);font:16px/1.8 system-ui,"Hiragino Sans","Noto Sans JP",sans-serif}
a{color:var(--gold)}.w{max-width:1080px;margin:0 auto;padding:0 16px}
header{background:#060a16;border-bottom:2px solid var(--gold)}header .w{display:flex;flex-wrap:wrap;align-items:center;gap:8px 20px;padding:10px 16px}
.logo{font-weight:800;font-size:22px;color:var(--gold);text-decoration:none;letter-spacing:.08em}.logo b{color:var(--red)}
nav{display:flex;flex-wrap:wrap;gap:4px 14px;font-size:14px}nav a{color:var(--tx);text-decoration:none}nav a:hover{color:var(--gold)}
.hero{padding:48px 0;background:linear-gradient(135deg,#0a1020,#16224a)}.hero h1{font-size:clamp(26px,5vw,40px);margin:0;color:var(--gold)}
.hero input{width:100%;max-width:480px;padding:12px;border-radius:6px;border:1px solid var(--gold);background:#0a1020;color:var(--tx);font-size:16px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:16px}
.card{background:var(--card);border:1px solid #243058;border-radius:8px;padding:14px;color:var(--tx);text-decoration:none;display:block}.card:hover{border-color:var(--gold)}
.card img{width:100%;height:auto;border-radius:4px}.meta{font-size:13px;color:var(--mu)}.tag{background:var(--red);color:#fff;border-radius:3px;padding:1px 8px;font-size:12px}
h2.s{border-left:5px solid var(--red);padding-left:10px;margin:40px 0 16px}
.art h2{border-bottom:2px solid var(--gold);padding-bottom:4px;margin-top:40px}.art h3{border-left:4px solid var(--red);padding-left:8px}
table{border-collapse:collapse;width:100%;display:block;overflow-x:auto}td,th{border:1px solid #243058;padding:8px}th{background:#16224a}
.toc,.note,.calc{background:var(--card);border:1px solid #243058;border-radius:8px;padding:14px 18px;margin:20px 0}.note{border-left:5px solid var(--red)}
.calc label{display:block;margin:8px 0}.calc input{padding:8px;width:100%;max-width:260px;background:#0a1020;color:var(--tx);border:1px solid #243058;border-radius:4px}.res{font-size:20px;color:var(--gold);font-weight:700}
.crumb{font-size:13px;color:var(--mu)}footer{margin-top:60px;background:#060a16;border-top:2px solid var(--gold);padding:24px 0;font-size:14px;color:var(--mu)}footer a{margin-right:14px}
</style></head><body>
<header><div class="w"><a class="logo" href="/">PACHI <b>DATA</b></a><nav>
<a href="/">ホーム</a><a href="/category/shindai/">新台情報</a><a href="/category/kouryaku/">機種攻略</a><a href="/category/data/">機種データ</a><a href="/category/beginner/">初心者講座</a><a href="/category/shop/">パチンコ店情報</a><a href="/tools/">収支・計算ツール</a></nav></div></header>
<main><slot /></main>
<footer><div class="w"><p><a href="/about/">運営者情報</a><a href="/contact/">お問い合わせ</a><a href="/privacy/">プライバシーポリシー</a><a href="/advertise/">広告掲載について</a><a href="/disclaimer/">免責事項</a></p>
<p>当サイトは遊技に関する情報提供を目的とし、勝利や利益を保証するものではありません。20歳未満の方は遊技できません。遊技は適度に。</p><p>© PACHI DATA</p></div></footer></body></html>
